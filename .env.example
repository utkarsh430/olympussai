# Copy to .env.local and fill in real values. Never commit .env.local.
#
# Section references below match README.md.

# --- Enterprise auth (Supabase) — Section 6 -----------------------------
# Project URL and anon key from Supabase Dashboard > Project Settings > API.
# Public by design: NEXT_PUBLIC_* values are embedded in the browser bundle,
# access is enforced by Supabase Auth + this app's session checks, not by
# keeping the anon key secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. SERVER-ONLY — never prefix with NEXT_PUBLIC_, never sent
# to the browser. Only used out-of-band by `pnpm run create-project-user` to
# provision accounts (no self-service sign-up).
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps ----------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Site / misc ------------------------------------------------------------
SITE_URL=https://olympuss.us
UPSRTC_LIVE_URL=
UPSRTC_SCHEDULE_URL=

# --- Placeholder-data policy -------------------------------------------------
# Governing principle: every algorithm and system operates on live data
# obtained from the APIs — never assumed or placeholder data.
# See src/lib/upsrtc/fixtureFallback.ts.
#
# NEXT_PUBLIC_DEMO_MODE=1 — explicit offline demo mode for presentations
# without connectivity. Forces the bundled fixtures and does not call the
# upstream at all. Deliberate, so it stays available.
NEXT_PUBLIC_DEMO_MODE=
#
# ALLOW_FIXTURE_FALLBACK — opt-in permission to substitute the bundled fixture
# (src/fixtures/upsrtc-*-sample.json) when a live call has FAILED and no real
# cached response exists. Accepted truthy values: 1 / true / yes / on.
#
# DEFAULT (absent or anything else): OFF. A failed call then returns an
# explicit `source: 'unavailable'` state with ZERO rows, rather than filling a
# dispatcher's fleet table with demo buses that do not exist. Leave it unset in
# every real deployment — it exists for local development and demos only.
#
# This does NOT govern the stale-cache path: serving a recently-cached REAL
# upstream response after a failed refresh is legitimate degradation, stays
# labelled `source: 'cache', stale: true`, and is never gated by this flag.
ALLOW_FIXTURE_FALLBACK=

# --- control-service integration --------------------------------------------
# Outbound: web -> control service (REST reads + the driver ack write).
CONTROL_SERVICE_BASE_URL=
CONTROL_SERVICE_SERVICE_TOKEN=
# Inbound: control service -> web. Shared HMAC-SHA256 key used to verify signed
# webhook deliveries at POST /api/control-service/webhook.
#
# MUST be byte-for-byte equal to the control service's WEBHOOK_HMAC_SECRET
# (control-service/.env.example) — it is the same key on both ends of one HMAC,
# not a pair. Rotate them together; a mismatch makes every delivery fail
# signature verification with a 400, which the sender does NOT retry, so every
# command lifecycle event is dropped silently.
#
# The control service side also needs WEB_APP_WEBHOOK_URL pointed at this
# route, i.e. WEB_APP_WEBHOOK_URL=https://<web-app>/api/control-service/webhook
# (already documented in control-service/.env.example). Deliveries are skipped
# there when it is unset, so an unset value looks like "nothing happening"
# rather than an error.
#
# Unset here: the handler answers 503 (retryable) rather than dropping events.
CONTROL_SERVICE_WEBHOOK_SECRET=

# --- PUBLIC PREVIEW: authentication switch (simulator-preview branch) -------
# DISABLE_AUTH takes the login off the whole app: no edge gate, no page guard,
# no API role check, and /login and /ops/login forward straight into the
# console. It exists so this branch can be deployed to a domain and shown to
# people who have no ops account. See src/lib/auth/publicPreview.ts.
#
# UNSET MEANS DISABLED. That is the opposite of every other flag in this file
# and it is deliberate: a preview that quietly keeps its login because a
# variable was forgotten is the failure the branch exists to avoid, and reads
# of process.env inside the middleware bundle are resolved at `next build`
# time, so a runtime-only variable would not reliably reach the edge gate.
#
#   (unset)             -> authentication OFF   <- what a preview deploy wants
#   DISABLE_AUTH=false  -> authentication ON    <- what everything else wants
#
# SET IT TO false BEFORE THIS CODE GOES ANYWHERE NEAR A REAL DEPLOYMENT, at
# BUILD time as well as run time. Under vitest the default flips to ON on its
# own so the auth suite keeps proving the real behaviour.
DISABLE_AUTH=
# The same decision, made visible to client components (they cannot read a
# non-public variable, and the "Sign out" button is hidden when auth is off).
# Only consulted when DISABLE_AUTH is unset; set both or neither.
NEXT_PUBLIC_DISABLE_AUTH=
# Optional. The ops_users email a preview visitor borrows an identity from.
# `claims.sub` is written into columns with an FK to ops_users(id), so
# borrowing a real active row keeps a preview's write paths working. Unset:
# the widest active account found, else a synthetic identity.
PREVIEW_OPS_USER_EMAIL=

# --- Ops RBAC (driver/dispatcher/depot/control-room/planner) ---------------
OPS_DATABASE_URL=
# HS256 signing secret for ops session tokens. Must be >= 32 characters
# (`openssl rand -base64 48`). Separate from Supabase's own session handling —
# the ops RBAC surface is a distinct auth system.
OPS_SESSION_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Control-room copilot (Claude subscription) ------------------------------
# The copilot authenticates with a Claude subscription, NOT a metered Anthropic
# API key. Mint a token on the machine that runs this app:
#
#     claude setup-token
#
# and paste it below. It is a secret: store it the same way you store
# OPS_SESSION_SECRET, never commit it, and note that it expires — when it does,
# the copilot returns 503 COPILOT_UNAVAILABLE with a message saying so, and you
# re-run `claude setup-token` to replace this value.
#
# Requires the `claude` CLI installed on the server (PATH, or CLAUDE_CLI_PATH).
# Unset means the three copilot endpoints (incident explanation, NL query,
# shift-report drafting) return 503 COPILOT_UNAVAILABLE rather than fabricating
# a response.
CLAUDE_CODE_OAUTH_TOKEN=
# Model id the copilot asks for. Defaults to claude-sonnet-4-5.
ANTHROPIC_MODEL=
# Optional. Absolute path to the `claude` binary when it is not on PATH.
CLAUDE_CLI_PATH=
# Optional. Per-request timeout in ms for a copilot completion. Defaults to 60000.
COPILOT_CLAUDE_TIMEOUT_MS=
#
# NOTE: ANTHROPIC_API_KEY is deliberately NOT used and is actively stripped from
# the model subprocess's environment (src/lib/copilot/claudeSubscription.ts) —
# claude-code gives an API key precedence over subscription credentials, so a
# stray key would silently move every copilot call onto per-token billing.

# --- Shared rate-limit / circuit-breaker store (optional) --------------------
# Upstash Redis REST endpoint + token. See src/lib/redis/client.ts.
#
# REDIS_URL is the SINGLE activation switch. Leave it unset (the default for
# local dev and for CI) and nothing changes: the failed-login limiter
# (src/lib/auth/rate-limit.ts), the copilot LLM call limiter
# (src/lib/copilot/rateLimit.ts) and the control-service circuit breaker
# (src/lib/controlService/client.ts) keep their original per-process in-memory
# counters. No Redis is required to run or test this app.
#
# Set it on any multi-instance or serverless deploy, where "5 failed logins per
# 15 minutes" per warm process — reset by every cold start — is not the control
# it looks like. With it set, all instances share one budget.
#
# If Redis is configured but unreachable, every caller falls back to its own
# in-process counter: never to "allowed" (that would let an attacker who can
# DoS Redis switch the login limiter off) and never to "denied" (that would
# lock an entire control room out of its console during an infra incident).
#
# REDIS_URL set without REDIS_TOKEN is a misconfiguration, not a way to disable
# Redis: it is logged at error level and the counters fall back to in-memory.
REDIS_URL=
REDIS_TOKEN=
