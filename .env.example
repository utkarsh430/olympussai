# Copy to .env.local and fill in real values. Never commit .env.local.
#
# Section references below match README.md.

# --- Enterprise auth (Supabase) — Section 6 -----------------------------
# Project URL and anon key from Supabase Dashboard > Project Settings > API.
# Public by design: NEXT_PUBLIC_* values are embedded in the browser bundle,
# access is enforced by Supabase Auth + this app's session checks, not by
# keeping the anon key secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. SERVER-ONLY — never prefix with NEXT_PUBLIC_, never sent
# to the browser. Only used out-of-band by `pnpm run create-project-user` to
# provision accounts (no self-service sign-up).
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps ----------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Site / misc ------------------------------------------------------------
SITE_URL=https://olympuss.us
UPSRTC_LIVE_URL=
UPSRTC_SCHEDULE_URL=
NEXT_PUBLIC_DEMO_MODE=

# --- control-service integration --------------------------------------------
# Outbound: web -> control service (REST reads + the driver ack write).
CONTROL_SERVICE_BASE_URL=
CONTROL_SERVICE_SERVICE_TOKEN=
# Inbound: control service -> web. Shared HMAC-SHA256 key used to verify signed
# webhook deliveries at POST /api/control-service/webhook.
#
# MUST be byte-for-byte equal to the control service's WEBHOOK_HMAC_SECRET
# (control-service/.env.example) — it is the same key on both ends of one HMAC,
# not a pair. Rotate them together; a mismatch makes every delivery fail
# signature verification with a 400, which the sender does NOT retry, so every
# command lifecycle event is dropped silently.
#
# The control service side also needs WEB_APP_WEBHOOK_URL pointed at this
# route, i.e. WEB_APP_WEBHOOK_URL=https://<web-app>/api/control-service/webhook
# (already documented in control-service/.env.example). Deliveries are skipped
# there when it is unset, so an unset value looks like "nothing happening"
# rather than an error.
#
# Unset here: the handler answers 503 (retryable) rather than dropping events.
CONTROL_SERVICE_WEBHOOK_SECRET=

# --- Ops RBAC (driver/dispatcher/depot/control-room/planner) ---------------
OPS_DATABASE_URL=
# HS256 signing secret for ops session tokens. Must be >= 32 characters
# (`openssl rand -base64 48`). Separate from Supabase's own session handling —
# the ops RBAC surface is a distinct auth system.
OPS_SESSION_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Control-room copilot (Anthropic) ---------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Shared rate-limit / circuit-breaker store (optional) --------------------
# Upstash Redis REST endpoint + token. See src/lib/redis/client.ts.
#
# REDIS_URL is the SINGLE activation switch. Leave it unset (the default for
# local dev and for CI) and nothing changes: the failed-login limiter
# (src/lib/auth/rate-limit.ts), the copilot LLM call limiter
# (src/lib/copilot/rateLimit.ts) and the control-service circuit breaker
# (src/lib/controlService/client.ts) keep their original per-process in-memory
# counters. No Redis is required to run or test this app.
#
# Set it on any multi-instance or serverless deploy, where "5 failed logins per
# 15 minutes" per warm process — reset by every cold start — is not the control
# it looks like. With it set, all instances share one budget.
#
# If Redis is configured but unreachable, every caller falls back to its own
# in-process counter: never to "allowed" (that would let an attacker who can
# DoS Redis switch the login limiter off) and never to "denied" (that would
# lock an entire control room out of its console during an infra incident).
#
# REDIS_URL set without REDIS_TOKEN is a misconfiguration, not a way to disable
# Redis: it is logged at error level and the counters fall back to in-memory.
REDIS_URL=
REDIS_TOKEN=
