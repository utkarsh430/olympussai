# control-service env vars. Copy to .env.local for local dev (gitignored).
# In Render, these are set per-environment via `render env set` against the
# control-service-staging / control-service-pilot services defined in
# render.yaml - never committed. See docs/CONTROL_SERVICE_DEPLOYMENT.md.

# Postgres/PostGIS connection string for this service's OWN datastore.
# Never the web app's Supabase connection string - the two datastores are
# intentionally isolated (docs/CONTROL_SERVICE_INTEGRATION.md section 3).
CONTROL_SERVICE_DATABASE_URL=postgres://user:pass@host:5432/control_service

# Bearer token the Next.js app sends on web -> control-service REST calls.
# Rotated out of band, distinct from PIN-session auth
# (docs/CONTROL_SERVICE_INTEGRATION.md section 1).
SERVICE_TOKEN_SECRET=

# HMAC-SHA256 key used to sign control-service -> web webhook deliveries.
WEBHOOK_HMAC_SECRET=

# Where signed webhooks are delivered - the web app's inbound handler
# (docs/CONTROL_SERVICE_INTEGRATION.md section 1), e.g.
# https://<web-app>/api/control-service/webhook. Deliveries are skipped
# (logged, not thrown) when unset, so the service can still boot locally
# without a target configured.
WEB_APP_WEBHOOK_URL=

# Error/perf tracking (separate Sentry project from the web app's).
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging

PORT=8080
LOG_LEVEL=info

# --- Ingestion / scheduler ---------------------------------------------
# How long the in-memory network-geometry snapshot (active route-direction
# shapes + stops + spatial grid) is served before a background refresh.
# Also the interval of the geometryRefresh scheduler job. Geometry only
# changes when the seeder is re-run, so minutes of staleness are fine.
SHAPE_CACHE_TTL_MS=900000

# In-process GPS poller: fetches the live feed, filters to status='Live',
# and pushes each fix through the same ingestion pipeline as
# POST /v1/positions. Leave FALSE on every instance except the one you
# want doing the polling - otherwise every replica ingests the same fixes.
GPS_POLL_ENABLED=false
GPS_POLL_INTERVAL_MS=30000
GPS_POLL_URL=https://margdarshi.upsrtcvlt.com/php/getGpsLiveData.php
# Fixes older than this are dropped instead of ingested.
GPS_MAX_AGE_SECONDS=300

# Headway compute sweep. Reactive-bunching detection latency is
#   required_samples x HEADWAY_COMPUTE_INTERVAL_MS x ceil(eligible / HEADWAY_BATCH_SIZE)
# so raising the interval multiplies time-to-first-detection directly.
HEADWAY_COMPUTE_INTERVAL_MS=60000
HEADWAY_BATCH_SIZE=60
HEADWAY_COMPUTE_CONCURRENCY=4
HEADWAY_VEHICLE_FRESHNESS_SECONDS=300

# 503 /readyz until at least one active route_direction has a route_shape.
# Defaults to true outside NODE_ENV=test.
REQUIRE_SEEDED_NETWORK=true

# Backstop TTL sweep for expired commands.
COMMAND_TTL_SWEEP_INTERVAL_MS=30000
